rem /Users/TimonGeisbauer/bbx/bin/bbj -CPbbj_default -WD/Users/TimonGeisbauer/git/intern/RestBridge/test/logger/ /Users/TimonGeisbauer/bbx/utils/bbjunittest/BBjUnitTest.bbj - TrafficLogger.bbjt --q